package javaapplication31;

import java.time.LocalDate;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;

interface Taxable {
    double TAX_RATE = 0.15;
    double calculateTax();
}

interface BonusCalculable {
    double calculateBonus(double performanceScore);
}

abstract class Employee implements Comparable<Employee>, Taxable, BonusCalculable {
    protected String id;
    protected String name;
    protected double baseSalary;
    protected LocalDate joinDate;

    public Employee(String id, String name, double baseSalary, LocalDate joinDate) {
        this.id = id;
        this.name = name;
        this.baseSalary = baseSalary;
        this.joinDate = joinDate;
    }

    public abstract double calculateNetSalary();

    @Override
    public double calculateTax() {
        return baseSalary * TAX_RATE;
    }

    @Override
    public int compareTo(Employee other) {
       
        return Double.compare(other.calculateNetSalary(), this.calculateNetSalary());
    }

    public String getId() { return id; }
    public String getName() { return name; }
    public double getBaseSalary() { return baseSalary; }
    public LocalDate getJoinDate() { return joinDate; }

    @Override
    public String toString() {
        return "ID: " + id + ", Name: " + name;
    }
}

class FullTimeEmployee extends Employee {
    private double allowance;

    public FullTimeEmployee(String id, String name, double baseSalary, LocalDate joinDate, double allowance) {
        super(id, name, baseSalary, joinDate);
        this.allowance = allowance;
    }

    @Override
    public double calculateNetSalary() {
        return baseSalary + allowance;
    }

    @Override
    public double calculateBonus(double performanceScore) {
       
        return (baseSalary * 0.10) * performanceScore;
    }
}

class ContractorEmployee extends Employee {
    private int hourlyRate;
    private int hoursWorked;

    public ContractorEmployee(String id, String name, LocalDate joinDate, int hourlyRate, int hoursWorked) {
        super(id, name, 0.0, joinDate);
        this.hourlyRate = hourlyRate;
        this.hoursWorked  = hoursWorked;
    }

    @Override
    public double calculateNetSalary() {
        return hourlyRate * hoursWorked;
    }

    @Override
    public double calculateBonus(double performanceScore) {
         
        if (performanceScore > 4.0) {
            return 500.0;
        }
        return 0.0;
    }
}

public class JavaApplication31 {
    public static void main(String[] args) {
        List<Employee> employees = new ArrayList<>();
        
        employees.add(new FullTimeEmployee("E001", "أحمد علي", 3000.0, LocalDate.of(2022, 5, 10), 500.0));
        employees.add(new ContractorEmployee("E002", "سارة محمد", LocalDate.of(2023, 1, 15), 50, 160));
        employees.add(new FullTimeEmployee("E003", "خالد عمر", 4500.0, LocalDate.of(2021, 11, 1), 800.0));

        Collections.sort(employees);
        System.out.println("--- الفرز الأول: حسب صافي الراتب تنازلياً ---");
        for (Employee e : employees) {
            System.out.println(e.getName() + " - صافي الراتب: " + e.calculateNetSalary());
        }

      
        employees.sort(Comparator.comparing(Employee::getJoinDate));
        System.out.println("\n--- الفرز الثاني: حسب تاريخ الانضمام ---");
        for (Employee e : employees) {
            System.out.println(e.getName() + " - تاريخ الانضمام: " + e.getJoinDate());
        }
        double totalTax = 0;
        double totalBonus = 0;

        for (Employee e : employees) {
            totalTax += e.calculateTax();
            totalBonus += e.calculateBonus(4.5); // افتراض تقييم 4.5

            if (e instanceof FullTimeEmployee) {
                FullTimeEmployee ft = (FullTimeEmployee) e;
            } else if (e instanceof ContractorEmployee) {
                ContractorEmployee ct = (ContractorEmployee) e;
            }
        }

        System.out.println("\n--- الإجماليات المالية ---");
        System.out.println("إجمالي الضرائب المستقطعة: " + totalTax);
        System.out.println("إجمالي المكافآت الممنوحة: " + totalBonus);
    }
}
